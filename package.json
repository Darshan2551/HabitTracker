{
  "name": "habittracker",
  "private": true,
  "version": "1.0.0",
  "description": "Production-ready Habit Tracker monorepo",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm --workspace apps/api run dev",
    "dev:all": "powershell -Command \"Start-Process npm -ArgumentList '--workspace','apps/api','run','dev'; npm --workspace apps/web run dev\"",
    "dev:api": "npm --workspace apps/api run dev",
    "dev:web": "npm --workspace apps/web run dev",
    "build": "npm run build:api && npm run build:web",
    "build:api": "npm --workspace apps/api run build",
    "build:web": "npm --workspace apps/web run build",
    "test": "npm run test:api && npm run test:web",
    "test:api": "npm --workspace apps/api run test",
    "test:web": "npm --workspace apps/web run test",
    "lint": "npm run lint:api && npm run lint:web",
    "lint:api": "npm --workspace apps/api run lint",
    "lint:web": "npm --workspace apps/web run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml,css,scss,html}\"",
    "compose:up": "docker compose up --build",
    "compose:down": "docker compose down -v"
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  },
  "engines": {
    "node": ">=20.11.0",
    "npm": ">=10.0.0"
  }
}
